rules_version = '2';

// File storage security rules.
service firebase.storage {
  match /b/{bucket}/o {

    // Website quote uploads: anyone may upload a PDF (max 25 MB) or a
    // sketch PNG (max 5 MB). Nobody may list or download them from a
    // browser except Numa staff.
    match /quote-uploads/{requestId}/{fileName} {
      allow create: if (request.resource.contentType == 'application/pdf'
                        && request.resource.size < 25 * 1024 * 1024)
                    || (fileName == 'sketch.png'
                        && request.resource.contentType == 'image/png'
                        && request.resource.size < 5 * 1024 * 1024);
      allow read, delete: if isStaff();
    }

    // Portal files (Phase 2), e.g. projects/{projectId}/drawings/{file}.pdf,
    // will check project membership like firestore.rules. Closed for now.
    match /{allPaths=**} {
      allow read, write: if isStaff();
    }

    function isStaff() {
      return request.auth != null && request.auth.token.numaStaff == true;
    }
  }
}
