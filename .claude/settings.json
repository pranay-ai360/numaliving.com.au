{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./api-keys.json)",
      "Read(**/api-keys.json)",
      "Edit(./api-keys.json)",
      "Edit(**/api-keys.json)",
      "Bash(*api-keys.json*)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh api --method DELETE *)",
      "Bash(gh repo delete *)"
    ]
  }
}
