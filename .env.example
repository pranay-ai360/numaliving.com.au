# Copy this file to .env.local for local development.
#
# Every NEXT_PUBLIC_ value is baked into the public site, so only put values
# here that are safe to publish.

# Where the "Request a Quote" form sends enquiries (FormSubmit.co).
# Use the random-string alias that FormSubmit emails you once the mailbox is
# activated (README, Going live, step 2). It keeps the mailbox address out of
# the page source, so never put the mailbox address itself here. Leave it empty
# and the form tells visitors to email instead, rather than pretending to send.
NEXT_PUBLIC_FORMSUBMIT_ID=

# Path prefix when the site is served from a sub-path, for example
# /numaliving.com.au on GitHub Pages. GitHub Actions sets this automatically
# when it builds for Pages, so leave it empty for local development.
NEXT_PUBLIC_BASE_PATH=
