rules_version = '2';

// Database security rules. These run on Google's servers, so they protect
// the data even if someone bypasses the website.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Website: quote requests ─────────────────────────────────────
    // Anyone may CREATE a request with the expected fields.
    // Nobody may read, change or delete them from a browser; the Numa
    // back office (Phase 2) reads them as staff.
    match /quoteRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly([
                         'name', 'company', 'email', 'phone', 'role', 'projectType',
                         'location', 'timeline', 'message', 'files', 'sketchPath',
                         'status', 'source', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 200
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('^[^@]+@[^@]+\\.[^@]+$')
                    && request.resource.data.message is string
                    && request.resource.data.message.size() < 10000
                    && request.resource.data.status == 'new'
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isStaff();
    }

    // ── Portal (Phase 2) ───────────────────────────────────────────
    // Planned shape:
    //   projects/{projectId}                 name, showcaseSlug, ...
    //   projects/{projectId}/members/{uid}   rights per module (see ProjectMember in src/lib/types.ts)
    //   projects/{projectId}/{module}/{id}   drawings, rfis, samples, ...
    // Each read/write will check the member's right for that module, e.g.
    //   get(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid))
    //     .data.rights.rfis in ['act', 'approve']
    // Until the portal is built, everything else is closed.
    match /{document=**} {
      allow read, write: if isStaff();
    }

    // Numa staff are marked with a custom claim set from the admin side.
    function isStaff() {
      return request.auth != null && request.auth.token.numaStaff == true;
    }
  }
}
